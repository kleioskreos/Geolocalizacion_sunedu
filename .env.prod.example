# Configuración exclusiva del mapa. Copiar a .env.prod y completar contraseñas.
# docker compose --env-file .env.prod -f compose.prod.yaml up -d --build
FRONTEND_URL=https://mapa.vmbperu.com
BACKEND_URL=https://mapabackend.vmbperu.com
# Dominios a configurar en la pestaña Domains de Dokploy:
# mapa.vmbperu.com -> web:8090
# mapabackend.vmbperu.com -> api:8091
# Dokploy asigna el nombre del proyecto con -p. No se publican puertos al host.
# Puertos internos fijos: web 8090, API 8091, PostgreSQL 5544.
# Desarrollo Vite 5190; vista previa Vite 5191.
POSTGRES_PASSWORD=GENERAR_HEXADECIMAL_ALEATORIO_PARA_MAPA
ADMIN_USER=admin
ADMIN_PASSWORD=GENERAR_PASSWORD_EXCLUSIVO_PARA_MAPA
